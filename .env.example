LLM_PROVIDER=openai
BASE_URL=https://openrouter.ai/api/v1
API_KEY=your-api-key-here

# YesScale (Anthropic Messages API) alternative:
# LLM_PROVIDER=yescale
# BASE_URL=https://api.yescale.io
# API_KEY=your-yescale-api-key
# MODEL_ID=claude-sonnet-4-6
# LLM_MAX_TOKENS=8192

# --- Experiment config ---
DATASET_NAME=UNSW_NB15
TRAIN_PATH=./datasets/UNSW_NB15_training-set.csv
TEST_PATH=./datasets/UNSW_NB15_testing-set.csv

CLASSIFICATION_TYPE=binary
# Options: binary | multiclass

TARGET_COLUMN=attack_cat
# UNSW_NB15 multiclass / NSL_KDD multiclass → attack_cat | binary → label

REDUCTION_METHOD=selection
# Legacy setting: loaded for compatibility but unused by the current pipeline.
# The LLM path uses the generated reduce_features() implementation.

MODEL_ID=openai/gpt-5-codex
USE_LLM=true
# true -> generate a new preprocessing file through the LLM API.
# false -> reuse GENERATED_FILE/GENERATED_FILES without an API call.
# MODEL_ID=traditional -> use built-in OneHotEncoder + MinMaxScaler; no API call.
# Other MODEL_ID values identify the LLM used to generate preprocessing code.
# OpenAI examples  : gpt-4o, gpt-4.1
# OpenRouter examples: openai/gpt-4.1, google/gemini-2.5-pro, deepseek/deepseek-r1-0528:free

# Set USE_LLM=false to reuse an existing file from generated/ without an API call.
# Use the filename only, not the full path. USE_LLM=true always generates new code.
# GENERATED_FILE=preprocessing_20260811_201903_gpt_5_4_multiclass_llm.py
# For USE_LLM=false with N_RUNS>1, provide exactly N_RUNS distinct filenames:
# GENERATED_FILES=artifact_01.py,artifact_02.py,artifact_03.py

N_RUNS=1
K_VALUES=auto
# LLM path: keep auto; Stage 3 chooses K from semantic seeds and RF+MI >= 0.55,
# with Pearson redundancy filtering and no K clamp.
# Traditional path: auto uses 24,26,28,30; alternatively provide a comma-separated K grid.
