# Dataset and multiclass target
DATASET_NAME=UNSW_NB15
TRAIN_PATH=./datasets/UNSW_NB15_training-set.csv
TEST_PATH=./datasets/UNSW_NB15_testing-set.csv
CLASSIFICATION_TYPE=multiclass
TARGET_COLUMN=attack_cat
# UNSW_NB15 / NSL_KDD: attack_cat; CIC_IDS_2017: Label

# LLM generation
LLM_PROVIDER=openai
BASE_URL=https://openrouter.ai/api/v1
API_KEY=your-api-key-here
MODEL_ID=openai/gpt-5-codex
USE_LLM=true
N_RUNS=1
# MODEL_ID identifies the LLM that generates code, not the evaluation classifier.
# USE_LLM=true generates fresh artifacts; false loads existing generated/ modules.

# YesScale / Anthropic Messages alternative
# LLM_PROVIDER=yescale
# BASE_URL=https://api.yescale.io
# MODEL_ID=claude-sonnet-4-6
# LLM_MAX_TOKENS=8192

# Reuse one existing module: USE_LLM=false, N_RUNS=1
# GENERATED_FILE=artifact_01.py
# Reuse multiple modules: USE_LLM=false, N_RUNS=3
# GENERATED_FILES=artifact_01.py,artifact_02.py,artifact_03.py
# Use filenames only; provide exactly N_RUNS distinct files for multiple runs.

# Optional USD prices per million tokens for cost reporting
# PRICE_PROMPT_PER_1M_USD=0
# PRICE_COMPLETION_PER_1M_USD=0
